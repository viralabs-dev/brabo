{
  "name": "brabo",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "docs:start": "pnpm docs:site && pnpm docs:serve",
    "docs:build": "pnpm docs:site && pnpm docs:site:check",
    "docs:serve": "python3 -m http.server 3000 -d build/docs-site",
    "docs:clear": "rm -rf build/docs-site",
    "docs:site": "node scripts/docs/site/build.mjs",
    "docs:site:check": "node scripts/docs/site/links.mjs && node scripts/docs/links-do-locale.mjs build/docs-site && node scripts/docs/faixa-de-traducao-check.mjs build/docs-site",
    "docs:generate": "node scripts/docs/generate.mjs",
    "docs:openapi-textos": "node scripts/docs/openapi-textos.mjs",
    "docs:landing": "node scripts/docs/landing.mjs",
    "docs:check": "node scripts/docs/docmap.mjs && node scripts/docs/generate.mjs --check",
    "docs:drift": "node scripts/docs/drift.mjs",
    "docs:audit": "node scripts/docs/audit.mjs",
    "docs:fontes": "bash scripts/docs/montar-layout.sh"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "dependencies": {
    "markdown-it": "14.1.0",
    "shiki": "4.5.0",
    "yaml": "^2.9.0",
    "picomatch": "^4.0.5"
  }
}
